{
	"workspace": [
		"./lib/sveltekit-remote-resources",
		"./sites/sveltekit-remote-resources-demo"
	],
	"tasks": {
		"build": {
			"command": "deno task --filter sveltekit-remote-resources build",
			"dependencies": [
				"check"
			]
		},
		"check": {
			"command": "deno task --filter sveltekit-remote-resources check"
		},
		"demo:dev": {
			"command": "deno task --filter sveltekit-remote-resources-demo dev"
		},
		"demo:build": {
			"command": "deno task --filter sveltekit-remote-resources-demo build",
			"dependencies": [
				"build"
			]
		},
		"demo:preview": {
			"command": "deno task --filter sveltekit-remote-resources-demo preview",
			"dependencies": [
				"demo:build"
			]
		},
		"demo:check": {
			"command": "deno task --filter sveltekit-remote-resources-demo check"
		}
	}
}
